#!/usr/bin/env bash
#
# Pre-commit gate: run the unit tests and the code-smell linter before every
# commit. Version-controlled here; installed via `bin/install-hooks.sh`.
#
# Bypass in a pinch with:  git commit --no-verify

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "▶ Running unit tests…"
if ! vendor/bin/phpunit; then
	echo "✗ Tests failed — commit aborted." >&2
	exit 1
fi

echo "▶ Checking for code smells (staged files)…"
if ! php bin/smell-lint.php; then
	echo "✗ High-severity code smells found — commit aborted." >&2
	echo "  Fix them, or run: git commit --no-verify to bypass." >&2
	exit 1
fi

echo "✓ Tests pass, no high-severity smells."
